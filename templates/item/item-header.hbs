<header class="sheet-header">
	<img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img"
		title="{{item.name}}" alt="{{item.name}}"/>
	<div class="header-fields">
		<h1 class="charname">
			<input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'Name'}}"/>
		</h1>
	</div>
</header>
