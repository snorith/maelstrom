<section class="tab attributes {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
	<div class="grid grid-2col">
		<div class="resource">
			<label>{{localize "MAELSTROM.item.ability.rank"}}
				<input type="text" name="system.rank" value="{{system.rank}}" class="rank"/>
			</label>
		</div>
		<div class="resource">
			<label>{{localize "MAELSTROM.item.ability.benefit"}}
				<input type="text" name="system.benefit" value="{{system.benefit}}" class="benefit"/>
			</label>
		</div>
	</div>
</section>
